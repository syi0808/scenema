{
  "name": "scenema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --filter './packages/**' build",
    "build:site": "pnpm build && vite build --config apps/site/vite.config.ts",
    "clean": "pnpm --recursive --filter './packages/**' clean",
    "dev": "vite --config apps/site/vite.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "svelte": "^5.56.10",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.23.0"
}
